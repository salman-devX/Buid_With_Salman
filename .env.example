# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form - pick ONE integration and fill in its keys.
# The contact form ships with validation only; it will not send
# anything until you wire it to one of the services below.

# --- EmailJS ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Formspree ---
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# --- Resend (server-side, used from an API route) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
